# -- LOGGING_LEVEL controls the verbosity of logs (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOGGING_LEVEL=DEBUG

# ollama models
OLLAMA_MODEL_NAME=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL_NAME=all-minilm:l6-v2

# LLM Model used in inference
INFERENCE_DEPLOYMENT_NAME=ollama/qwen3.5:0.8b
INFERENCE_BASE_URL=http://localhost:11434
INFERENCE_API_KEY=t

# Embeddings Model
EMBEDDINGS_DEPLOYMENT_NAME=ollama/all-minilm:l6-v2
EMBEDDINGS_BASE_URL=http://localhost:11434
EMBEDDINGS_API_KEY=t

# -- FASTAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# -- FRONTEND
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8080

# Request timeouts (seconds) and rate-limit retries
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_RETRY_WAIT_SECONDS=2
INFERENCE_MAX_ATTEMPTS=3
CHAT_TIMEOUT_SECONDS=90
BACKEND_REQUEST_TIMEOUT_SECONDS=120
BACKEND_CONNECT_TIMEOUT_SECONDS=5
