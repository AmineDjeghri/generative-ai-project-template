// Renovate configuration. The shared base (managers, grouping, release-age cooldown,
// badges) lives in https://github.com/AmineDjeghri/renovate-config (default.json5).
// Rules below are repo-specific and override the shared ones (later rules win).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>AmineDjeghri/renovate-config:default.json5"],

  packageRules: [
    // ---- Repo-specific rules (keep last) ----
    // pyproject.toml: `python-semantic-release` (`[dependency-groups]`)
    {
      description: "Review semantic-release updates against the documented instructor click/rich dependency conflict",
      matchManagers: ["pep621"],
      matchPackageNames: ["python-semantic-release"],
      dependencyDashboardApproval: true,
      addLabels: ["needs-compatibility-review"],
    },
    // backend/pyproject.toml: `torch` (cpu and cuda extras)
    {
      description: "Look up torch on PyPI: the PyTorch indexes list local-tagged versions (+cpu, +cu132)",
      matchManagers: ["pep621"],
      matchPackageNames: ["torch"],
      registryUrls: ["https://pypi.org/pypi/"],
      addLabels: ["needs-compatibility-review"],
    },
  ],
}
