// Renovate configuration. Later packageRules override earlier ones.
// Each block below says which file it acts on.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // ---- Global behaviour (applies to every file Renovate finds) ----
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":dependencyDashboard",
  ],
  labels: ["renovate", "dependencies"],
  dependencyDashboardLabels: ["renovate"],
  commitMessageTopic: "{{datasource}} dependency {{depName}}",
  mode: "full",
  prCreation: "immediate",
  prConcurrentLimit: 10,
  prHourlyLimit: 10,

  // Security advisories (GitHub + OSV): open at once, ungrouped, as `fix`, labelled `security`.
  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
    semanticCommitType: "fix",
  },
  osvVulnerabilityAlerts: true,
  pinDigests: false,
  platformAutomerge: false,

  // ---- Managers ----
  // Periodic refresh of every lock file -> uv.lock
  lockFileMaintenance: {
    enabled: true,
  },
  // Reads the `rev:` of each hook repo -> .pre-commit-config.yaml
  "pre-commit": {
    enabled: true,
  },
  // Custom manager: reads `default_language_version: node:` -> .pre-commit-config.yaml
  customManagers: [
    {
      customType: "regex",
      description: "Track the Node runtime used by pre-commit hooks",
      managerFilePatterns: ["/^\\.pre-commit-config\\.ya?ml$/"],
      matchStrings: [
        "(?:^|\\r?\\n)default_language_version:[ \\t]*\\r?\\n(?:[ \\t]+[^\\r\\n]*\\r?\\n)*?[ \\t]+node:[ \\t]*['\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)['\"]?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)",
      ],
      depNameTemplate: "node",
      datasourceTemplate: "node-version",
      versioningTemplate: "node",
    },
  ],

  // ---- Rules ----
  packageRules: [
    // All pyproject.toml files: only offer PyPI releases compatible with `requires-python`.
    {
      description: "Preserve compatibility with the full supported Python range",
      matchDatasources: ["pypi"],
      constraintsFiltering: "strict",
    },
    // pyproject.toml -> `[project] requires-python`: widened only after approval on the dashboard,
    // in one PR with the Docker image below. The exact CI Python (`UV_PYTHON`) is not tracked: bump it by hand.
    {
      description: "Widen Python support after reviewing the CI matrix and all project constraints",
      matchManagers: ["pep621"],
      matchDepTypes: ["requires-python"],
      rangeStrategy: "widen",
      semanticCommitType: "fix",
      groupName: "python runtime",
      dependencyDashboardApproval: true,
    },
    // Dockerfile* -> `FROM python:...`: follows the supported-runtime update above, needs approval.
    {
      description: "Keep Python Docker images with supported-runtime updates",
      matchManagers: ["dockerfile"],
      matchPackageNames: ["python"],
      groupName: "python runtime",
      semanticCommitType: "fix",
      dependencyDashboardApproval: true,
    },
    // .pre-commit-config.yaml -> `rev:` of each hook repo.
    {
      description: "Group pre-commit updates (tooling only, no release)",
      matchManagers: ["pre-commit"],
      groupName: "pre-commit dependencies",
      groupSlug: "pre-commit",
      minimumReleaseAge: "7 days",
      semanticCommitType: "chore",
    },
    // .pre-commit-config.yaml -> `default_language_version: node:` (found by the custom manager above).
    {
      description: "Maintain stable pre-commit Node runtime updates as tooling",
      matchManagers: ["custom.regex"],
      matchDatasources: ["node-version"],
      matchPackageNames: ["node"],
      minimumReleaseAge: "7 days",
      semanticCommitType: "chore",
      ignoreUnstable: true,
      rangeStrategy: "pin",
    },
    // Same Node version as above: a new major opens a normal PR, labelled for compatibility review.
    {
      description: "Review major LTS upgrades of the pre-commit Node runtime",
      matchManagers: ["custom.regex"],
      matchDatasources: ["node-version"],
      matchPackageNames: ["node"],
      matchUpdateTypes: ["major"],
      addLabels: ["needs-compatibility-review"],
    },
    // .github/workflows/*.yml and .github/actions/*/action.yml -> pinned `uses:` actions.
    {
      description: "Group GitHub Actions updates (CI only, no release)",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      groupSlug: "github-actions",
      minimumReleaseAge: "7 days",
      semanticCommitType: "chore",
    },
    // pyproject.toml -> `[project] dependencies` and `[project.optional-dependencies]` (extras).
    {
      description: "Runtime Python dependencies and extras -> trigger a patch release",
      matchManagers: ["pep621"],
      matchDepTypes: ["dependencies", "project.dependencies", "project.optional-dependencies"],
      groupName: "python dependencies",
      groupSlug: "python",
      minimumReleaseAge: "7 days",
      semanticCommitType: "fix",
    },
    // pyproject.toml -> `[dependency-groups]` (dev, docs).
    {
      description: "Dev/docs Python dependency updates (dependency-groups) -> tooling only, no release needed",
      matchManagers: ["pep621"],
      matchDepTypes: ["devDependencies", "dependency-groups"],
      groupName: "python dev dependencies",
      groupSlug: "python-dev",
      minimumReleaseAge: "7 days",
      semanticCommitType: "chore",
    },
    // Same dependencies as the runtime rule above: a new major opens a normal PR, labelled for breaking-change review.
    {
      description: "Major bumps of production deps need manual review for breaking changes",
      matchManagers: ["pep621"],
      matchDepTypes: ["dependencies", "project.dependencies", "project.optional-dependencies"],
      matchUpdateTypes: ["major"],
      addLabels: ["needs-breaking-review"],
      semanticCommitType: "fix",
    },
    // pyproject.toml -> `[build-system] requires`. Declare BOTH bounds there (`>=floor,<=latest-tested`):
    // Renovate skips a requirement with no version, and `replace` raises the `<=` bound on each release.
    {
      description: "Build-system requirements: keep a two-sided range and move its upper bound",
      matchManagers: ["pep621"],
      matchDepTypes: ["build-system.requires"],
      rangeStrategy: "replace",
      semanticCommitType: "chore",
      minimumReleaseAge: "7 days",
    },

    // ---- Repo-specific rules (keep last: they override the rules above) ----
    // Anything below may differ between repos; everything above must not.
    // pyproject.toml -> runtime deps, extras and dependency-groups: rewrite ranges to exact `==` pins.
    {
      description: "Pin exact versions of runtime and dev Python dependencies",
      matchManagers: ["pep621"],
      matchDepTypes: [
        "dependencies",
        "project.dependencies",
        "project.optional-dependencies",
        "devDependencies",
        "dependency-groups",
      ],
      rangeStrategy: "pin",
    },
    // backend/ and frontend/ pyproject.toml share one uv.lock: a package used by both is updated in one branch.
    {
      description: "Packages declared in several workspace members share one uv.lock entry: update every member in the same branch",
      matchManagers: ["pep621"],
      matchPackageNames: ["pydantic", "pydantic-settings", "loguru"],
      groupName: "workspace shared dependencies",
      groupSlug: "python-shared",
    },
    // pyproject.toml -> `python-semantic-release` (dev group): manual review.
    {
      description: "Review semantic-release updates against the documented instructor click/rich dependency conflict",
      matchManagers: ["pep621"],
      matchPackageNames: ["python-semantic-release"],
      dependencyDashboardApproval: true,
      addLabels: ["needs-compatibility-review"],
    },
    // backend/pyproject.toml -> `torch` (cpu and cuda extras): manual review.
    {
      description: "Review PyTorch updates against both CPU and CUDA indexes and extras",
      matchManagers: ["pep621"],
      matchPackageNames: ["torch"],
      dependencyDashboardApproval: true,
      addLabels: ["needs-compatibility-review"],
    },
  ],
}
